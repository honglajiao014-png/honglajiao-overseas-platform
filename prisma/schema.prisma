generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("dealer")
  phone     String?
  company   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles  Vehicle[]
  inquiries Inquiry[]
  orders    Order[]
  chatMessages ChatMessage[]
}

model VehicleSpec {
  id          String   @id @default(cuid())
  brand       String
  model       String
  yearRange   String   @default("2016-2026") // e.g. "2018-2022"
  manufacturer String? // 厂商
  vehicleType String?  // 生产方式
  releaseDate String?  // 上市时间
  energyType  String?  // 能源形式
  specs       String   @default("{}") // JSON - all config key-value pairs
  // specs JSON structure example:
  // {
  //   "engine": {"model":"EA211-DJS","intake":"涡轮增压","displacement":"1.4","cylinders":"4","maxPower":"110","maxTorque":"250",...},
  //   "transmission": {"type":"湿式双离合","gears":"7",...},
  //   "body": {"structure":"SUV","doors":"5","seats":"5","wheelbase":"2680","length":"4495",...},
  //   "chassis": {"drive":"前置前驱","frontSuspension":"麦弗逊式","rearSuspension":"多连杆式",...},
  //   "safety": {"airbags":["驾驶座","前排侧"],"abs":true,...},
  //   "exterior": {"sunroof":"可开启全景天窗","wheels":"铝合金",...},
  //   "interior": {"steering":"多功能方向盘","display":"全液晶仪表盘",...},
  //   "seats": {"material":"皮/Alcantara混搭","heating":"前排",...},
  //   "media": {"screen":"触控液晶屏","bluetooth":true,"speakers":"10-11喇叭",...},
  //   "lights": {"daytimeRunning":true,"autoHeadlights":true,...},
  //   "mirrors": {"adjustment":"电动调节","heating":true,"folding":"锁车自动折叠",...},
  //   "ac": {"type":"自动空调","rearVents":true,"zoneControl":true}
  // }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  model       String
  year        Int
  type        String   @default("Used Passenger Car")
  mileage     Int?
  transmission String?
  fuel        String?
  steering    String?
  color       String?
  condition   String   @default("Excellent")
  supplier    String?
  location    String   @default("China")
  images      String[] @default([])
  basePrice   Float    @default(0)
  markup      Float    @default(0)
  salePrice   Float    @default(0)
  profit      Float    @default(0)
  status      String   @default("available")
  soldAt      DateTime?
  soldTo      String?
  dealerId    String?
  dealer      User?    @relation(fields: [dealerId], references: [id])
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  description String?
  // Auto-linked spec
  specId      String?
  spec        VehicleSpec? @relation(fields: [specId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inquiries   Inquiry[]
  orders      Order[]
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  contact     String
  country     String?
  vehicleType String?
  message     String
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  buyerName   String
  buyerContact String
  salePrice   Float
  profit      Float
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
