generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("dealer")
  phone     String?
  company   String?
  country   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles  Vehicle[]
  inquiries Inquiry[]
  orders    Order[]
  chatMessages ChatMessage[]
}

model VehicleSpec {
  id          String   @id @default(cuid())
  brand       String
  model       String
  yearRange   String   @default("2016-2026")
  manufacturer String?
  vehicleType String?
  releaseDate String?
  energyType  String?
  specs       String   @default("{}")
  vehicles    Vehicle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  model       String
  year        Int
  type        String   @default("Used Passenger Car")
  mileage     Int?
  transmission String?
  fuel        String?
  steering    String?
  color       String?
  condition   String   @default("Excellent")
  supplier    String?
  location    String   @default("China")
  images      String[] @default([])
  basePrice   Float    @default(0)
  markup      Float    @default(0)
  salePrice   Float    @default(0)
  profit      Float    @default(0)
  status      String   @default("available")
  soldAt      DateTime?
  soldTo      String?
  dealerId    String?
  dealer      User?    @relation(fields: [dealerId], references: [id])
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  description String?
  specId      String?
  spec        VehicleSpec? @relation(fields: [specId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inquiries   Inquiry[]
  orders      Order[]
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  contact     String
  country     String?
  vehicleType String?
  message     String
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  buyerName   String
  buyerContact String
  salePrice   Float
  profit      Float
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
