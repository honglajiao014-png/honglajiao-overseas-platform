generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        String
  content     String
  userId      String?
  createdAt   DateTime    @default(now())
  ChatSession ChatSession @relation(fields: [sessionId], references: [id])
  User        User?       @relation(fields: [userId], references: [id])

  @@index([sessionId])
}

model ChatSession {
  id               String        @id @default(cuid())
  userId           String?
  visitorId        String?
  intentLevel      Int           @default(0)
  country          String?
  vehicleReq       String?
  budget           String?
  quantity         Int?
  contactCollected Boolean       @default(false)
  formFilled       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  ChatMessage      ChatMessage[]
  User             User?         @relation(fields: [userId], references: [id])

  @@index([intentLevel])
  @@index([userId])
}

model CustomerLead {
  id          String    @id @default(cuid())
  name        String?
  email       String?
  phone       String?
  country     String?
  vehicleReq  String?
  budget      String?
  quantity    Int?
  source      String?
  intentLevel Int       @default(0)
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([emailSent])
  @@index([email])
  @@index([intentLevel])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  contact     String
  country     String?
  vehicleType String?
  message     String
  vehicleId   String?
  userId      String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])
  Vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Order {
  id           String   @id @default(cuid())
  vehicleId    String
  buyerName    String
  buyerContact String
  salePrice    Float
  profit       Float
  userId       String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User?    @relation(fields: [userId], references: [id])
  Vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  password    String
  name        String
  role        String        @default("dealer")
  phone       String?
  company     String?
  country     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  avatar      String?
  ChatMessage ChatMessage[]
  ChatSession ChatSession[]
  Inquiry     Inquiry[]
  Order       Order[]
  Vehicle     Vehicle[]
}

model Vehicle {
  id               String       @id @default(cuid())
  slug             String       @unique
  brand            String
  model            String
  year             Int
  type             String       @default("Used Passenger Car")
  mileage          Int?
  transmission     String?
  fuel             String?
  steering         String?
  color            String?
  condition        String       @default("Excellent")
  supplier         String?
  location         String       @default("China")
  images           String[]     @default([])
  basePrice        Float        @default(0)
  markup           Float        @default(0)
  salePrice        Float        @default(0)
  profit           Float        @default(0)
  status           String       @default("available")
  soldAt           DateTime?
  soldTo           String?
  dealerId         String?
  published        Boolean      @default(true)
  featured         Boolean      @default(false)
  deleted          Boolean      @default(false)
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  specId           String?
  batteryType      String?
  bodyStyle        String?
  compatibleModels String?
  displacement     Float?
  displacementCc   Int?
  engineModel      String?
  engineNo         String?
  equipmentType    String?
  exteriorColor    String?
  fuelType         String?
  interiorColor    String?
  keyCount         Int?
  loadCapacityTons Float?
  motorPowerKw     Float?
  motorcycleType   String?
  originalPrice    Float?
  partCategory     String?
  partCondition    String?
  quantity         Int?
  rangeKm          Int?
  seatCount        Int?
  series           String?
  sourceId         String?
  sourceSite       String?
  specsJson        String?
  tonnage          Float?
  uploadedAt       DateTime     @default(now())
  vehicleLengthM   Float?
  workingHours     Int?
  driveType        String?
  doorCount        Int?
  wheelbase        Int?
  curbWeight       Int?
  fuelConsumption  Float?
  maxTorqueNm      Int?
  maxHorsepower    Int?
  fuelTankCapacity Int?
  fuelGrade        String?
  Inquiry          Inquiry[]
  Order            Order[]
  User             User?        @relation(fields: [dealerId], references: [id])
  VehicleSpec      VehicleSpec? @relation(fields: [specId], references: [id])
}

model VehicleSpec {
  id           String    @id @default(cuid())
  brand        String
  model        String
  yearRange    String    @default("2016-2026")
  manufacturer String?
  vehicleType  String?
  releaseDate  String?
  energyType   String?
  specs        String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Vehicle      Vehicle[]

  @@unique([brand, model])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  name      String?
  password  String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}
