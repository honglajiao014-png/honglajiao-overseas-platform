generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("dealer")
  phone     String?
  company   String?
  country   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles  Vehicle[]
  inquiries Inquiry[]
  orders    Order[]
  chatMessages ChatMessage[]
  chatSessions ChatSession[]
}

model VehicleSpec {
  id          String   @id @default(cuid())
  brand       String
  model       String
  yearRange   String   @default("2016-2026")
  manufacturer String?
  vehicleType String?
  releaseDate String?
  energyType  String?
  specs       String   @default("{}")
  vehicles    Vehicle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  model       String
  year        Int
  type        String   @default("Used Passenger Car")
  mileage     Int?
  transmission String?
  fuel        String?
  steering    String?
  color       String?
  condition   String   @default("Excellent")
  supplier    String?
  location    String   @default("China")
  images      String[] @default([])
  basePrice   Float    @default(0)
  markup      Float    @default(0)
  salePrice   Float    @default(0)
  profit      Float    @default(0)
  status      String   @default("available")
  soldAt      DateTime?
  soldTo      String?
  dealerId    String?
  dealer      User?    @relation(fields: [dealerId], references: [id])
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  description String?
  specId      String?
  spec        VehicleSpec? @relation(fields: [specId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inquiries   Inquiry[]
  orders      Order[]
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  contact     String
  country     String?
  vehicleType String?
  message     String
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  buyerName   String
  buyerContact String
  salePrice   Float
  profit      Float
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model ChatSession {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  visitorId   String?
  intentLevel Int      @default(0)  // 0=L0, 1=L1, 2=L2, 3=L3, 4=L4
  country     String?
  vehicleReq  String?
  budget      String?
  quantity    Int?
  contactCollected Boolean @default(false)
  formFilled       Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ChatMessage[]

  @@index([userId])
  @@index([intentLevel])
}

model CustomerLead {
  id             String   @id @default(cuid())
  name           String?
  email          String?
  phone          String?
  country        String?
  vehicleReq     String?
  budget         String?
  quantity       Int?
  source         String?  // chat / register / inquiry
  intentLevel    Int      @default(0)
  emailSent      Boolean  @default(false)
  emailSentAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([intentLevel])
  @@index([emailSent])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  name      String?
  password  String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}
